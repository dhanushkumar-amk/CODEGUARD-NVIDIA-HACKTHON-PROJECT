# Nebius Token Factory & AI Model Configuration
NEBIUS_TOKEN_FACTORY_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_ULTRA_MODEL_ID=nvidia/nemotron-4-340b-instruct
NEMOTRON_NANO_MODEL_ID=nvidia/nemotron-mini-4b-instruct

# Nebius AI Cloud Sandbox Configuration
NEBIUS_SANDBOX_API_KEY=your_nebius_sandbox_api_key_here
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_SANDBOX_DEFAULT_IMAGE=node:20
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_CONCURRENT=3

# GitHub Integration (Personal Access Token with repo scope)
GITHUB_TOKEN=your_github_personal_access_token_here

# Tavily Web Search Grounding Configuration
TAVILY_API_KEY=tvly-your_tavily_api_key_here
TAVILY_ENABLED=true
TAVILY_MAX_SEARCHES_PER_SCAN=12

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
