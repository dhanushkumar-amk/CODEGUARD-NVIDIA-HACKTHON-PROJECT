# =============================================================================
# CodeGuard Backend - Production Environment Variables
# Use this template to configure Nebius Serverless Endpoints or cloud containers.
# IMPORTANT: Never commit actual secret keys or credentials to source control.
# =============================================================================

# Application environment mode (set to "production" in hosted cloud environments)
ENVIRONMENT=production

# Enable or disable verbose debugging logs (set to False for production)
DEBUG=False

# Network host address to bind the uvicorn server (0.0.0.0 listens on all container interfaces)
HOST=0.0.0.0

# Network port number the backend application listens on inside the container
PORT=8000

# Public URL of the hosted frontend application allowed to make cross-origin requests
FRONTEND_ORIGIN=https://codeguard-frontend.vercel.app

# JSON array or comma-separated list of allowed CORS origins including local and cloud domains
CORS_ORIGINS=["https://codeguard-frontend.vercel.app","http://localhost:5173","http://localhost:3000"]

# Nebius Token Factory API key used to authenticate OpenAI-compatible LLM inference requests
NEBIUS_TOKEN_FACTORY_API_KEY=your_production_nebius_token_factory_api_key

# Base URL for the Nebius Token Factory OpenAI-compatible API endpoint
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model identifier for the primary NVIDIA Nemotron Ultra model (used for root-cause diagnosis and code fix generation)
NEMOTRON_ULTRA_MODEL_ID=nvidia/Nemotron-3-Ultra-550b-a55b

# Model identifier for the fast NVIDIA Nemotron model (used for violation filtering and pre-classification)
NEMOTRON_NANO_MODEL_ID=nvidia/Nemotron-3_5-Lightning

# Model identifier for the lightweight smoke test and speed-optimized inference endpoint
NEMOTRON_FAST_MODEL_ID=nvidia/Nemotron-3_5-Lightning

# Maximum number of high-capacity Ultra model inference calls permitted per repository scan
ULTRA_MAX_CALLS_PER_SCAN=10

# Maximum USD budget allowance permitted for Ultra model inference calls per scan
ULTRA_BUDGET_USD_PER_SCAN=0.05

# Feature flag to enable or disable the high-capacity NVIDIA Nemotron Ultra diagnosis engine
ULTRA_ENABLED=true

# Number of top-ranked accessibility violations to submit to the deep AI diagnosis pipeline
DIAGNOSIS_TOP_N=15

# Model tier selected for generating code remediations ("ultra" or "nano")
FIX_GENERATION_MODEL=ultra

# Minimum violation severity threshold required to trigger automated code remediation ("critical", "high", or "medium")
FIX_MIN_SEVERITY=medium

# Nebius AI Cloud Sandbox API key used to provision and execute isolated testing containers
NEBIUS_SANDBOX_API_KEY=your_production_nebius_sandbox_api_key

# Base URL for the Nebius AI Cloud Sandbox container orchestration service
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Container base image used by Nebius Sandboxes when executing Playwright, axe-core, and test runners
NEBIUS_SANDBOX_DEFAULT_IMAGE=node:20

# Maximum execution timeout in seconds for shell commands executed inside a Nebius Sandbox
SANDBOX_TIMEOUT_SECONDS=120

# Maximum number of concurrent active sandbox containers permitted per scan pipeline
SANDBOX_MAX_CONCURRENT=3

# Maximum timeout in seconds allocated for repository dependency installation (npm install) in sandboxes
NPM_INSTALL_TIMEOUT_SECONDS=180

# GitHub Personal Access Token (classic or fine-grained with 'repo' scope) for PR and branch creation
GITHUB_TOKEN=ghp_your_production_github_personal_access_token
